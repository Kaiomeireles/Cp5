@model GameStoreMVC.Models.Game

@{
    ViewData["Title"] = "Cadastrar Game";
}

<div class="container" style="max-width: 700px;">
    <div class="shadow-lg p-4 rounded-4" style="background-color: #ffffff; border: 1px solid var(--light-blue-bg);">

        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: var(--primary-navy);">
                <i class="bi bi-plus-circle me-2" style="color: var(--accent-purple);"></i>Cadastrar Novo Game
            </h3>
            <p class="text-muted small">Preencha os dados do jogo</p>
        </div>

        <form asp-action="Criar" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                <input asp-for="Titulo" class="form-control form-control-sm" placeholder="Ex: The Witcher 3" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                <textarea asp-for="Descricao" class="form-control form-control-sm" rows="3" placeholder="Descrição do jogo..."></textarea>
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Genero" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                    <input asp-for="Genero" class="form-control form-control-sm" placeholder="Ex: RPG, Ação..." />
                    <span asp-validation-for="Genero" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Plataforma" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                    <input asp-for="Plataforma" class="form-control form-control-sm" placeholder="Ex: PC, PS5, Xbox..." />
                    <span asp-validation-for="Plataforma" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Preco" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                    <input asp-for="Preco" class="form-control form-control-sm" type="number" step="0.01" placeholder="99.90" />
                    <span asp-validation-for="Preco" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DataLancamento" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                    <input asp-for="DataLancamento" class="form-control form-control-sm" type="date" />
                    <span asp-validation-for="DataLancamento" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ImagemUrl" class="form-label small fw-semibold" style="color: var(--primary-navy);"></label>
                <input asp-for="ImagemUrl" class="form-control form-control-sm" placeholder="https://exemplo.com/imagem.jpg" />
                <span asp-validation-for="ImagemUrl" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn text-white fw-bold shadow-sm flex-grow-1"
                        style="background-color: var(--accent-purple); border: none; padding: 10px;">
                    <i class="bi bi-check-lg me-1"></i>Cadastrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

