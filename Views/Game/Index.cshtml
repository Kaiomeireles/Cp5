@model List<GameStoreMVC.Models.Game>

@{
    ViewData["Title"] = "Games";
    var isAdmin = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Admin";
}

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: var(--primary-navy);">
        <i class="bi bi-controller me-2" style="color: var(--accent-purple);"></i>Catálogo de Games
    </h2>
    @if (isAdmin)
    {
        <a asp-action="Criar" class="btn text-white fw-bold shadow-sm"
           style="background-color: var(--accent-purple); border: none;">
            <i class="bi bi-plus-lg me-1"></i>Novo Game
        </a>
    }
</div>

<div class="row g-4">
    @foreach (var game in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="game-card h-100 d-flex flex-column">
                <div style="height: 180px; overflow: hidden; border-radius: 15px 15px 0 0;">
                    @if (!string.IsNullOrEmpty(game.ImagemUrl))
                    {
                        <img src="@game.ImagemUrl" alt="@game.Titulo" class="w-100 h-100" style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background-color: var(--light-blue-bg);">
                            <i class="bi bi-image fs-1" style="color: var(--accent-purple);"></i>
                        </div>
                    }
                </div>
                <div class="p-3 flex-grow-1 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold mb-0" style="color: var(--primary-navy);">@game.Titulo</h5>
                        <span class="badge" style="background-color: var(--accent-purple);">@game.Genero</span>
                    </div>
                    <p class="text-muted small flex-grow-1" style="min-height: 40px;">
                        @(game.Descricao?.Length > 60 ? game.Descricao.Substring(0, 60) + "..." : game.Descricao)
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="fw-bold fs-5" style="color: var(--primary-navy);">R$ @game.Preco.ToString("F2")</span>
                        <span class="badge bg-secondary">@game.Plataforma</span>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Editar" asp-route-id="@game.Id" class="btn btn-sm btn-outline-primary w-50">
                                <i class="bi bi-pencil-square me-1"></i>Editar
                            </a>
                            <a asp-action="Deletar" asp-route-id="@game.Id" class="btn btn-sm btn-outline-danger w-50">
                                <i class="bi bi-trash me-1"></i>Excluir
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-inbox fs-1" style="color: var(--accent-purple);"></i>
        <p class="text-muted mt-3">Nenhum game cadastrado ainda.</p>
        @if (isAdmin)
        {
            <a asp-action="Criar" class="btn text-white fw-bold" style="background-color: var(--accent-purple);">
                Cadastrar primeiro game
            </a>
        }
    </div>
}

